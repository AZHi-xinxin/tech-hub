<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tech-hub"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/reloadButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/ink" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
        地址档案切换器放在 WebView（含聊天输入框）下方，与产品草图一致。
        selected = 当前实际连接；activated = 用户选择的模式。
    -->
    <LinearLayout
        android:id="@+id/addressTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/toolbar"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/autoAddressTab"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.72"
            android:background="@drawable/bg_address_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="自动"
            android:textColor="@color/address_tab_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeAddressTab"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Home"
            android:textColor="@color/address_tab_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/awayAddressTab"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_address_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Outside"
            android:textColor="@color/address_tab_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
