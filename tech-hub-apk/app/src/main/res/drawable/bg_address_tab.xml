<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 当前实际连接的地址：填充、描边，配合代码里的 elevation 呈现按下/抬起状态。 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/address_active_bg" />
            <stroke android:width="1dp" android:color="@color/address_active_stroke" />
        </shape>
    </item>

    <!-- 当前选择的模式（自动/固定地址），但连接尚未落到该地址。 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/address_mode_bg" />
            <stroke android:width="1dp" android:color="@color/address_mode_stroke" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/address_pressed_bg" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>

