# tech-hub 凭证模板 — 复制为 credentials.env 并替换成自己的随机串
# 生成建议: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 权限: chmod 600 credentials.env  （本文件绝不入库、绝不公开真实值）

HUMAN_TOKEN=replace_with_random_secret
CLAUDE_TOKEN=replace_with_random_secret
CODEX_TOKEN=replace_with_random_secret
DSH_TOKEN=replace_with_random_secret
RIKKA_TOKEN=replace_with_random_secret

# ---- 可选配置（不设则用默认值） ----
# TECH_HUB_IDENTITIES=human,claude,codex,dsh,rikka
# TECH_HUB_WORKER_IDENTITIES=claude,codex,dsh
# TECH_HUB_SYSTEM_IDENTITY=claude
# TECH_HUB_STOP_PHRASE=本次任务已结束
# TECH_HUB_PORT=8791
# TECH_HUB_DB=/path/to/techhub.db
