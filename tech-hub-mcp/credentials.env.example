# Copy to credentials.env, chmod 600, and replace every placeholder.
TECHHUB_MCP_TOKEN=<generate-a-separate-random-token>
TECHHUB_BASE_URL=http://127.0.0.1:8791
TECHHUB_MCP_HOST=0.0.0.0
TECHHUB_MCP_PORT=8793
TECHHUB_MCP_ISSUER_URL=http://<tailscale-ip>:8793
TECHHUB_MCP_RESOURCE_URL=http://<tailscale-ip>:8793/mcp
TECHHUB_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,<lan-ip>:8793,<tailscale-ip>:8793
# Native MCP clients normally send no Origin header. Add exact browser origins only if needed.
TECHHUB_MCP_ALLOWED_ORIGINS=

# TECHHUB_TOKEN is intentionally absent. The launcher maps the existing
# RIKKA_TOKEN from tech-hub/credentials.env into TECHHUB_TOKEN at runtime.
